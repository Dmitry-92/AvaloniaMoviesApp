<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="AvaloniaMoviesApp.Views.ReviewEditDialog"
        x:ClassModifier="public"
        Title="Редактирование отзыва"
        Width="400" Height="250"
        WindowStartupLocation="CenterOwner"
        CanResize="False">
        
        <StackPanel Margin="20" Spacing="15">
            <TextBlock Text="Оценка (1-5): " FontWeight="Bold"></TextBlock>
            <NumericUpDown Name="RatingBox" Minimum="1" Maximum="5" Value="5" Width="100"/>
            
            <TextBlock Text="Комментарий:" FontWeight="Bold"/>
            <TextBox Name="CommentBox" Height="80" TextWrapping="Wrap" AcceptsReturn="True"/>
        
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10" Margin="0,10,0,0">
                <Button Name="SaveButton" Content="💾 Сохранить" MinWidth="100" Background="DodgerBlue"/>
                <Button Name="CancelButton" Content="❌ Отмена" MinWidth="100"/>
            </StackPanel>
        </StackPanel>
</Window>